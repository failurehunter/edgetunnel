# Нормализация переводов строк и атрибуты файлов.
# Цель: рабочее дерево и содержимое git identичны на любой ОС.

# По умолчанию: в репозитории LF, при выдаче — как есть.
* text=auto eol=lf

# ── Эталон, который проверяется по sha256 ──────────────────────────────
# legacy/frozen.js — неизменяемый оракул (diff-харнесс, снапшот-тест
# хотпатчей). npm run hash-frozen сверяет его с эталоном из плана, поэтому
# конверсия переводов строк сломала бы проверку на любой машине.
legacy/frozen.js -text

# Скрипты с shebang — должны оставаться LF, иначе не запустятся.
scripts/*.sh text eol=lf

# Исходники: LF, но язык помечен @ts-nocheck и содержит CJK-идентификаторы —
# это UTF-8, конверсия не должна трогать содержимое.
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Сгенерированные типы wrangler.
src/worker-configuration.d.ts text eol=lf
